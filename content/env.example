# Copy to ~/.hal9001/env and fill in. KEY=VALUE per line; injected into every
# sensor and command node. Keep this file private (chmod 600).
#
# A sensor can also hold its own values: set them in the sensor's Environment
# section in the UI (or `hal9001 sensors env set <sensor-id> KEY`). They are
# stored in ~/.hal9001/env.d/sensors/<sensor-id>.env (git-ignored), reach only
# that sensor, and override a same-named variable from this file.
#
# Every value is secret by default: never shown by the UI or API, and replaced
# by «KEY» in stored output. A value that is not sensitive (a login name, a host
# name) can be marked plain: the Secret toggle in the env editor, `--plain` on
# `hal9001 env set` / `hal9001 sensors env set`, or a comment line made of the
# word hal:plain after the hash and the key names (the UI and CLI write it for
# you). Plain values are shown and are not redacted from output.

# --- slack-mentions-dms ---------------------------------------------------
# User token (xoxp-...) from a Slack app installed to your workspace.
# User token scopes: search:read, im:history, im:read, users:read
SLACK_USER_TOKEN=

# --- github-notifications -------------------------------------------------
# No variable needed: uses the existing `gh auth login` session.
# The token must be allowed to read notifications (classic scope: notifications,
# or `repo`), and to read pull requests for the triage-github size router.

# --- linear-assigned ------------------------------------------------------
# Personal API key from Linear: Settings > Account > Security & access.
# Read-only access is enough.
LINEAR_API_KEY=

# --- imap-mail ------------------------------------------------------------
# Mail over IMAP (the default email sensor). Set these on the sensor itself, in its
# Environment section in the UI or `hal9001 sensors env set imap-mail IMAP_PASSWORD --stdin`;
# they are stored in env.d/sensors/imap-mail.env and reach only that sensor. They also work
# here, but prefer the sensor.
# IMAP_USER=you@gmail.com
# IMAP_PASSWORD=             # Gmail: an app password (Google account > Security > 2-Step Verification > App passwords)
# IMAP_HOST=imap.gmail.com   # default
# IMAP_PORT=993              # default
# IMAP_TLS=ssl               # ssl (default) | starttls | none (tests and local bridges only; sends the password in clear)
# IMAP_MAILBOX=INBOX         # default
# IMAP_SEARCH=UNSEEN         # IMAP search criteria, default UNSEEN
# IMAP_MAX=50                # newest messages per poll, default 50
# IMAP_USER, IMAP_HOST, IMAP_PORT, IMAP_TLS, IMAP_MAILBOX, IMAP_SEARCH and IMAP_MAX are not
# sensitive: mark them plain so your address is not shown as «IMAP_USER» in stored mail items
# (`hal9001 sensors env set imap-mail IMAP_USER --plain`). Keep IMAP_PASSWORD secret.
# Gmail needs IMAP enabled in its settings. A Workspace admin can disable IMAP or app passwords;
# then the poll fails with AUTHENTICATIONFAILED and only the admin can fix it. Nothing is marked read.

# --- gmail-unread (alternative, needs Google OAuth) -----------------------
# No variable required: uses the gog CLI's own OAuth (`gog auth add you@example.com`).
# Optional: pick the account when gog has several.
# GOG_ACCOUNT=you@example.com
