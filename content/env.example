# Copy to ~/.hal9001/env and fill in. KEY=VALUE per line; injected into every
# sensor and command node. Keep this file private (chmod 600).
#
# A sensor can also hold its own values: set them in the sensor's Environment
# section in the UI (or `hal9001 sensors env set <sensor-id> KEY`). They are
# stored in ~/.hal9001/env.d/sensors/<sensor-id>.env (git-ignored), reach only
# that sensor, and override a same-named variable from this file.

# --- slack-mentions-dms ---------------------------------------------------
# User token (xoxp-...) from a Slack app installed to your workspace.
# User token scopes: search:read, im:history, im:read, users:read
SLACK_USER_TOKEN=

# --- github-notifications -------------------------------------------------
# No variable needed: uses the existing `gh auth login` session.
# The token must be allowed to read notifications (classic scope: notifications,
# or `repo`), and to read pull requests for the triage-github size router.

# --- linear-assigned ------------------------------------------------------
# Personal API key from Linear: Settings > Account > Security & access.
# Read-only access is enough.
LINEAR_API_KEY=

# --- gmail-unread ---------------------------------------------------------
# No variable required: uses the gog CLI's own OAuth (`gog auth add you@example.com`).
# Optional: pick the account when gog has several.
# GOG_ACCOUNT=you@example.com
